 "html": "\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; border-bottom: 2px solid #cbd5e1; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #334155; margin-bottom: 0px;\">\n  <tr>\n    <td width=\"55%\" valign=\"middle\" style=\"padding: 3px 0; font-size: 16px; font-weight: bold; text-transform: uppercase; color: #1e293b; letter-spacing: 0.3px;\">\n      INTERIM PAYMENT CERTIFICATE &nbsp;&nbsp;<span style=\"color: #000000; font-weight: normal;\">{{ doc.name }}</span>\n    </td>\n    <td width=\"45%\" valign=\"middle\" style=\"padding: 3px 0; text-align: right; font-family: monospace; font-size: 11px; color: #000000; line-height: 1.5;\">\n        <span style=\"display: inline-block; background-color: #f1f5f9; color: #000000; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase; margin-right: 6px;\">Contract: {{ doc.contract }}</span>\n    </td>\n  </tr>\n</table>\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #334155;\">\n  <tr>\n    <td width=\"100%\" valign=\"top\" style=\"padding: 4px 0 !important;\">\n      <div style=\"font-size: 12px; font-weight: bold; color: #1e293b; text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 6px;\">\n        {{ doc.customer }}\n      </div>\n    </td>\n  </tr>\n</table>\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #334155; margin-top: 10px;\">\n  <tr>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">Project</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold;\">{{ doc.project }}</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">Claim Title</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold;\">{{ doc.claim_title }}</td>\n  </tr>\n  <tr>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">Date of Claim</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-family: monospace;\">{{ doc.get_formatted('posting_date') }}</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">Period</td>\n    <td width=\"25%\" valign=\"top\" style=\"padding: 4px 0 !important; color: #000000; font-family: monospace;\">{{ doc.get_formatted('period_from') }} - {{ doc.get_formatted('period_to') }}</td>\n  </tr>\n</table>\n\n<br>\n<div style=\"font-size: 11px; font-weight: bold; margin-bottom: 5px;\">A. Valuation of Work Executed</div>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #000000; border: 1px solid #cbd5e1; margin-top: 5px;\">\n    <thead>\n        <tr style=\"background-color: #e2e8f0; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">\n            <th align=\"left\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">BOQ Item</th>\n            <th align=\"left\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Description</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Qty This Period</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Cum. Qty</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Unit Rate</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Cum. Value</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.claim_items %}\n        <tr style=\"background-color: {{ loop.cycle('#ffffff', '#f8f9fa') }};\">\n            <td valign=\"top\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ item.boq_item or '-' }}</td>\n            <td valign=\"top\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0;\">{{ item.item_description or '' }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"%.2f\"|format(item.this_period_qty) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"%.2f\"|format(item.cumulative_qty) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.unit_rate) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.cumulative_value) }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n{% if doc.variations %}\n<br>\n<div style=\"font-size: 11px; font-weight: bold; margin-bottom: 5px;\">B. Claimed Variations</div>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #000000; border: 1px solid #cbd5e1; margin-top: 5px;\">\n    <thead>\n        <tr style=\"background-color: #e2e8f0; color: #000000; font-weight: bold; text-transform: uppercase; font-size: 10px; letter-spacing: 0.3px;\">\n            <th align=\"left\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Variation Order</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Approved Amt</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Prev. Certified</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Claimed This Period</th>\n            <th align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1;\">Cum. Amount</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.variations %}\n        <tr style=\"background-color: {{ loop.cycle('#ffffff', '#f8f9fa') }};\">\n            <td valign=\"top\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ item.variation_order or '-' }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.approved_amount) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.previously_certified) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.this_period_amount) }}</td>\n            <td valign=\"top\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #e2e8f0; font-family: monospace;\">{{ \"{:,.2f}\".format(item.cumulative_amount) }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n{% endif %}\n\n<br>\n<div style=\"font-size: 11px; font-weight: bold; margin-bottom: 5px;\">C. Financial Summary</div>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 11px; color: #334155; margin-top: 5px;\">\n  <tr>\n    <td width=\"55%\" valign=\"top\" style=\"padding-right: 30px !important; padding-top: 2px !important;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse;\">\n        <tr>\n          <td style=\"padding: 3px 0 !important; color: #000000; font-weight: bold; font-size: 11px; letter-spacing: 0.3px;\">1. Value of Work Executed</td>\n          <td align=\"right\" style=\"padding: 3px 0 !important; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.total_work_executed) }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 3px 0 !important; color: #000000; font-weight: bold; font-size: 11px; letter-spacing: 0.3px;\">2. Add: Approved Variations</td>\n          <td align=\"right\" style=\"padding: 3px 0 !important; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.approved_variations) }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 3px 0 !important; color: #000000; font-weight: bold; font-size: 11px; letter-spacing: 0.3px;\">3. Materials on Site</td>\n          <td align=\"right\" style=\"padding: 3px 0 !important; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.materials_on_site) }}</td>\n        </tr>\n        <tr style=\"border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1; background-color: #f1f5f9;\">\n          <td style=\"padding: 3px 0 !important; color: #000000; font-weight: bold; font-size: 11px; letter-spacing: 0.3px;\">4. Gross Valuation</td>\n          <td align=\"right\" style=\"padding: 3px 0 !important; font-family: monospace; color: #000000; font-size: 11px; font-weight: bold;\">{{ \"{:,.2f}\".format(doc.gross_valuation) }}</td>\n        </tr>\n      </table>\n    </td>\n\n    <td width=\"45%\" valign=\"top\" style=\"padding-top: 2px !important;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"width: 100%; border-collapse: collapse; border: 1px solid #cbd5e1; background-color: #ffffff;\">\n        <tr>\n          <td width=\"65%\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-weight: bold; font-size: 11px; color: #000000;\">5. Less: Retention ({{ doc.retention_percentage }}%)</td>\n          <td width=\"35%\" align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.retention_deduction) }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-weight: bold; font-size: 11px; color: #000000;\">6. Less: Advance Recovery</td>\n          <td align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.advance_payment_recovery) }}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-weight: bold; font-size: 11px; color: #000000;\">7. Less: Prev. Certified</td>\n          <td align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-family: monospace; color: #000000; font-size: 11px;\">{{ \"{:,.2f}\".format(doc.previous_certified_amount) }}</td>\n        </tr>\n        <tr style=\"background-color: #f1f5f9;\">\n          <td style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-weight: bold; font-size: 11px; color: #000000;\">Net Amount Due (Excl. VAT)</td>\n          <td align=\"right\" style=\"padding: 3px 8px !important; border: 1px solid #cbd5e1; font-weight: bold; font-family: monospace; color: #000000; font-size: 12px;\">{{ \"{:,.2f}\".format(doc.net_amount_due) }}</td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n</table>\n\n<br><br><br>\n<table style=\"width: 100%; margin-top: 5px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\">\n  <tr>\n    <td width=\"33%\" style=\"text-align: center; padding: 0 5px !important;\">\n      <div style=\"border-top: 1px solid #000000; width: 100%; max-width: 220px; margin: 0 auto 6px auto;\"></div>\n      <div style=\"font-weight: 600; font-size: 11px; color: #000000; text-transform: uppercase; letter-spacing: 0.5px;\">Contractor Sign</div>\n    </td>\n\n    <td width=\"33%\" style=\"text-align: center; padding: 0 5px !important;\">\n      <div style=\"border-top: 1px solid #000000; width: 100%; max-width: 220px; margin: 0 auto 6px auto;\"></div>\n      <div style=\"font-weight: 600; font-size: 11px; color: #000000; text-transform: uppercase; letter-spacing: 0.5px;\">Consultant / QS Sign</div>\n    </td>\n    \n    <td width=\"33%\" style=\"text-align: center; padding: 0 5px !important;\">\n      <div style=\"border-top: 1px solid #000000; width: 100%; max-width: 220px; margin: 0 auto 6px auto;\"></div>\n      <div style=\"font-weight: 600; font-size: 11px; color: #000000; text-transform: uppercase; letter-spacing: 0.5px;\">Client Sign</div>\n    </td>\n  </tr>\n</table>\n",
